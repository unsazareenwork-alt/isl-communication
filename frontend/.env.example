# Frontend environment variables (prefix VITE_ is required by Vite).
# Only public configuration belongs here — never put secrets in the frontend.

# Base URL of the ISL backend (REST + Socket.IO).
# Leave unset to default to http://localhost:5000 for local development.
# For production, set to the deployed backend origin, e.g.:
# VITE_API_URL=https://your-deployed-backend.example.com

# AI WebSocket URL (sign language detection).
# Leave unset to default to ws://127.0.0.1:8765 in dev, wss://isl-ai-server.onrender.com in prod.
# To test local frontend against the deployed AI server:
# VITE_AI_WS_URL=wss://isl-ai-server.onrender.com
